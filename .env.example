# ==============================================================
# TEMPLATE for .env - copy it and fill in the empty values:
#   cp .env.example .env
# The .env file is NEVER committed (see .gitignore).
#
# Empty value  = a secret, fill it in yourself.
# Filled value = plain configuration, safe to share.
# ==============================================================

# --- PostgreSQL: raw + reporting layers ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=transactions
# "postgres" is the service name from docker-compose; that is how
# other containers reach it. Use "localhost" from your own machine.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Kafka: streaming layer ---
# From inside Docker use kafka:9092, from your machine localhost:29092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=transactions
# Consumer group - Kafka stores the read offset under this key
KAFKA_CONSUMER_GROUP=raw-writer

# --- Airflow: batch layer ---
# Airflow's internal database (run history, UI accounts).
# Not exposed outside the Docker network.
AIRFLOW_DB_USER=
AIRFLOW_DB_PASSWORD=
# UID that Airflow uses to write into ./logs.
# Keep 50000 on macOS; on Linux use the output of: id -u
AIRFLOW_UID=50000

# Key used to encrypt connections/passwords in Airflow's database.
# Generate with:
#   docker run --rm apache/airflow:2.11.0 \
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Airflow UI login, created on first startup
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=
