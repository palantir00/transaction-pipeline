# ==============================================================
# WZOR pliku .env - skopiuj do .env i uzupelnij puste wartosci:
#   cp .env.example .env
# Plik .env NIGDY nie trafia do repozytorium (jest w .gitignore).
# ==============================================================

# --- PostgreSQL: warstwa raw + reporting ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=transactions
# "postgres" = nazwa serwisu w docker-compose (tak widza go inne kontenery).
# Z laptopa (np. pytest lokalnie) uzyj: localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Kafka: warstwa strumieniowa ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=transactions
# Grupa konsumencka - Kafka zapamietuje pod tym kluczem, co juz przeczytalismy
KAFKA_CONSUMER_GROUP=raw-writer

# --- Airflow: warstwa batchowa ---
# Klucz szyfrowania hasel/polaczen w bazie Airflow.
# Wygeneruj: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Login do UI Airflow (tworzony przy pierwszym starcie)
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=
